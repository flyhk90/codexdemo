.container {
  padding: 40rpx;
  padding-bottom: 120rpx;
}

.score-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.score-display {
  text-align: center;
}

.score-label {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 20rpx;
}

.score-value {
  font-size: 120rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.2;
  transition: transform 0.15s ease;
}

.score-value.scale {
  transform: scale(1.1);
}

.control-panel {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
}

.button-group {
  margin-bottom: 30rpx;
}

.button-group:last-child {
  margin-bottom: 0;
}

.button-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.buttons-row {
  display: flex;
  justify-content: space-between;
}

.btn {
  width: 140rpx;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  transition: all 0.2s ease;
}

.btn:active {
  transform: scale(0.95);
}

.btn-add {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-add:active {
  background: linear-gradient(135deg, #5a6fd6 0%, #6a4190 100%);
}

.btn-subtract {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: #fff;
}

.btn-subtract:active {
  background: linear-gradient(135deg, #e080e8 0%, #e54558 100%);
}

.action-panel {
  display: flex;
  gap: 20rpx;
}

.btn-reset, .btn-history {
  flex: 1;
  height: 96rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: all 0.2s ease;
}

.btn-reset {
  background: rgba(255, 255, 255, 0.9);
  color: #f5576c;
  border: 2rpx solid #f5576c;
}

.btn-history {
  background: rgba(255, 255, 255, 0.9);
  color: #667eea;
  border: 2rpx solid #667eea;
}

.btn-reset:active, .btn-history:active {
  opacity: 0.8;
}

.history-panel {
  margin-top: 30rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.history-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.history-clear {
  font-size: 26rpx;
  color: #999;
}

.history-list {
  max-height: 400rpx;
}

.empty-history {
  text-align: center;
  color: #999;
  padding: 40rpx;
  font-size: 28rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.history-item:last-child {
  border-bottom: none;
}

.history-value {
  width: 120rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.history-value.positive {
  color: #667eea;
}

.history-value.negative {
  color: #f5576c;
}

.history-score {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding-left: 20rpx;
}

.history-time {
  font-size: 24rpx;
  color: #999;
}